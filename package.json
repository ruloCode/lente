{
  "name": "lente",
  "version": "0.0.1",
  "private": true,
  "description": "Real-time meeting copilot for people working in their second language, built on Meta's models.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ping": "node --env-file-if-exists=.env src/ping.ts",
    "bench:llm": "node --env-file-if-exists=.env scripts/bench-llm.ts",
    "bench:asr": "node --env-file-if-exists=.env scripts/bench-asr.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval/run.ts",
    "eval:render": "node scripts/eval/render.ts",
    "bench:cache": "node --env-file-if-exists=.env scripts/bench-cache.ts",
    "bench:help": "node --env-file-if-exists=.env scripts/bench-help.ts",
    "bench:live-view": "node scripts/bench-live-view.ts",
    "test": "node --test test/*.test.ts",
    "gen:fixtures": "node scripts/gen-fixtures-header.ts",
    "typecheck": "tsc --noEmit",
    "pilot": "node --env-file-if-exists=.env src/pilot.ts",
    "deploy:hub": "modal deploy --strategy recreate deploy/modal/hub.py",
    "smoke": "node scripts/smoke.ts",
    "progress": "node scripts/progress/serve.ts",
    "auto": "node scripts/auto/run.ts",
    "auto:cloud-setup": "node scripts/auto/cloud-setup.ts",
    "stub": "node scripts/stub-serve.ts",
    "android:build": "cd android && ./gradlew assembleDebug --console=plain -q",
    "android:test": "cd android && ./gradlew testDebugUnitTest --console=plain -q",
    "android:e2e": "node scripts/android-e2e.ts",
    "android:apk": "cd android && ./gradlew assembleRelease --console=plain -q && ls -l app/build/outputs/apk/release/app-release.apk"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
